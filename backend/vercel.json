{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": {
    "api/index.ts": { "maxDuration": 60 }
  },
  "crons": [{ "path": "/api/cron/daily", "schedule": "30 3 * * *" }]
}
