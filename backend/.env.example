# ───────────── Core ─────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
# Public URL of the storefront (used in emails / WhatsApp links)
FRONTEND_URL=http://localhost:3000
# Public URL of this API (used for webhooks)
API_URL=http://localhost:4000

# ───────────── Database ─────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce

# ───────────── Auth ─────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters-long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30
# Google Sign-In (OAuth client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=

# ───────────── Payments (Razorpay) ─────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ───────────── Email (Gmail SMTP) ─────────────
# Use a Google App Password: https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=ShopNest

# ───────────── SMS ─────────────
# Provider: twilio | msg91 | console (console just logs — good for dev)
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=
MSG91_DLT_TEMPLATE_ID=

# ───────────── WhatsApp (Meta WhatsApp Cloud API) ─────────────
# Provider: meta | console
WHATSAPP_PROVIDER=console
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Verify token you set in the Meta dashboard for the webhook
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Language code of your approved templates
WHATSAPP_TEMPLATE_LANG=en

# ───────────── Jobs ─────────────
# Set to false to disable the in-process scheduler (e.g. when running multiple API replicas)
ENABLE_JOBS=true
# Hours of inactivity before a cart counts as abandoned
ABANDONED_CART_HOURS=3

# ───────────── Seed ─────────────
ADMIN_EMAIL=admin@shopnest.dev
ADMIN_PASSWORD=Admin@12345
