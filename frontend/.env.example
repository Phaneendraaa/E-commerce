# Where the Express API runs (used by the /api proxy and server-side rendering)
API_URL=http://localhost:4000
# Public URL of this storefront (canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google Sign-In client ID (same as backend GOOGLE_CLIENT_ID) — optional
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
